{
  "name": "dsh-plugin-tcm-learning",
  "version": "0.1.0",
  "description": "中医学习：在 DSH 里用工作区 Markdown 搭一座中医书架（板块、书脊、阅读、配置）",
  "type": "module",
  "license": "MIT",
  "author": "lsh-lenvast",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tcm",
    "中医",
    "markdown",
    "bookshelf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsh-lenvast/dsh-plugin-tcm-learning.git"
  },
  "homepage": "https://github.com/lsh-lenvast/dsh-plugin-tcm-learning#readme",
  "bugs": {
    "url": "https://github.com/lsh-lenvast/dsh-plugin-tcm-learning/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "prepublishOnly": "node build.mjs"
  },
  "devDependencies": {
    "dompurify": "3.2.6",
    "esbuild": "0.25.10",
    "marked": "15.0.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
